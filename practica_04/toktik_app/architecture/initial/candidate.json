    "cards":  [
                  {
                      "dot":  "cyan",
                      "title":  "Flujo principal",
                      "items":  [
                                    "Mobile, Desktop y Web conectan directamente con Flutter Runtime / Flutter App.",
                                    "El runtime crea DiscoverProvider y DiscoverScreen; el estado alimenta el feed vertical."
                                ]
                  },
                  {
                      "dot":  "emerald",
                      "title":  "Datos locales",
                      "items":  [
                                    "VideoPostRepository se implementa mediante VideoPostsRepositoryImpl y LocalVideoDatasource.",
                                    "El datasource espera dos segundos, convierte los mapas locales en VideoPost y devuelve la lista al estado.",
                                    "La consulta de favoritos sigue sin implementarse."
                                ]
                  },
                  {
                      "dot":  "violet",
                      "title":  "Reproduccion multimedia",
                      "items":  [
                                    "FullscreenPlayer usa video_player, inicia en silencio y en loop, y alterna la reproduccion al tocar.",
                                    "Los videos estan declarados como assets/videos en pubspec.yaml; la carpeta assets aparece sin seguimiento en el arbol de trabajo."
                                ]
                  }
